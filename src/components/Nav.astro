---
interface Props {
  page: 'work' | 'about' | 'career' | 'fun';
}
const { page } = Astro.props;
const workHref = page === 'work' ? '#work' : '/';
---
<nav class="navigation">
  <a href={workHref} class={`nav-link${page === 'work' ? ' active' : ''}`}>Work</a>
  <a href="/career.html" class={`nav-link${page === 'career' ? ' active' : ''}`}>Career</a>
  <a href="/fun.html" class={`nav-link${page === 'fun' ? ' active' : ''}`}>Fun</a>
  <a href="/about.html" class={`nav-link${page === 'about' ? ' active' : ''}`}>About</a>
  <button type="button" class="nav-link" commandfor="cvPicker" command="toggle-popover">Resume</button>
  <button class="theme-toggle" id="themeToggle" aria-label="Toggle dark mode">
    <svg class="icon-moon" width="18" height="18" aria-hidden="true"><use href="#icon-moon"/></svg>
    <svg class="icon-sun" width="18" height="18" aria-hidden="true"><use href="#icon-sun"/></svg>
  </button>
</nav>
