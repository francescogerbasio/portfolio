---
import type { WeatherScene, WeatherTimeOfDay } from '../lib/weatherScene';

interface Props {
  id?: string;
  scene?: WeatherScene;
  timeOfDay?: WeatherTimeOfDay;
}

const {
  id = 'weatherLandscape',
  scene = 'clear',
  timeOfDay = 'day'
} = Astro.props;
---

<svg
  id={id}
  class="weather-landscape"
  data-scene={scene}
  data-time-of-day={timeOfDay}
  viewBox="0 0 160 66"
  role="presentation"
  aria-hidden="true"
  focusable="false"
>
  <g class="wl-stars" aria-hidden="true">
    <circle cx="16" cy="12" r=".7" />
    <circle cx="42" cy="8" r=".5" />
    <circle cx="72" cy="16" r=".65" />
    <circle cx="103" cy="9" r=".5" />
    <circle cx="143" cy="20" r=".7" />
  </g>

  <g class="wl-celestial" aria-hidden="true">
    <g class="wl-sun">
      <circle class="wl-sun-ring" cx="27" cy="17" r="6" />
      <circle class="wl-sun-core" cx="27" cy="17" r="1.7" />
    </g>
    <path class="wl-moon" d="M29 9.5a7.5 7.5 0 1 0 4.7 13.3A8.1 8.1 0 0 1 29 9.5Z" />
  </g>

  <g class="wl-clouds" aria-hidden="true">
    <path class="wl-cloud wl-cloud-back" d="M43 27c4-4 8-5 13-3 3-4 9-5 13-1 3-1 7 1 8 4-8 2-20 3-34 2Z" />
    <path class="wl-cloud wl-cloud-front" d="M69 35c4-4 9-5 14-2 3-5 10-6 14-1 4-1 8 1 10 5-10 2-25 2-38 1Z" />
  </g>

  <g class="wl-rain" aria-hidden="true">
    <line x1="77" y1="38" x2="74" y2="47" />
    <line x1="88" y1="38" x2="85" y2="48" />
    <line x1="99" y1="38" x2="96" y2="47" />
    <line x1="110" y1="38" x2="107" y2="48" />
  </g>

  <g class="wl-snow" aria-hidden="true">
    <circle cx="72" cy="39" r="1" />
    <circle cx="84" cy="45" r=".8" />
    <circle cx="98" cy="40" r="1" />
    <circle cx="112" cy="47" r=".9" />
  </g>

  <g class="wl-horizons" aria-hidden="true">
    <path class="wl-horizon wl-horizon-back" d="M-12 48c17-5 27-6 41-3 14 4 22 5 36 1 15-4 27-3 41 2 15 5 29 3 66-5v29H-12Z" />
    <path class="wl-horizon wl-horizon-mid" d="M-12 54c16-4 30-3 44 1 13 4 23 3 36-1 16-5 27-3 42 2 16 5 31 4 62-3v19H-12Z" />
    <path class="wl-horizon wl-horizon-front" d="M-12 61c17-4 31-3 46 1 13 4 25 4 39 0 16-4 29-2 43 1 16 4 32 3 56-2v17H-12Z" />
  </g>

  <g class="wl-fog" aria-hidden="true">
    <path d="M6 45c18-2 31-2 49 0s31 2 49 0 32-2 50 0" />
    <path d="M-4 53c19-2 32-2 50 0s32 2 50 0 35-2 68 0" />
  </g>

  <path class="wl-lightning" d="m119 24-5 8h4l-3 7 8-10h-4l4-5Z" aria-hidden="true" />

  <g class="wl-reading" aria-hidden="true">
    <text class="wl-temperature" id="weatherTemp" x="113" y="13">--°</text>
    <text class="wl-condition" id="weatherDesc" x="113" y="20">LOADING...</text>
  </g>
</svg>
