# ─────────────────────────────────────────────────────────────
# Cache headers — Netlify
# Deploy alongside your site files.
# For Vercel: rename to vercel.json and see the commented block below.
# ─────────────────────────────────────────────────────────────

# Prevent proxies from modifying content (stops email obfuscation)
/*
  Cache-Control: no-transform
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

# HTML — short cache so deploys are picked up immediately
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Astro hashed bundles — immutable because filename includes content hash
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# CSS & JS — always revalidate so updates are picked up immediately
/*.css
  Cache-Control: public, no-cache

/*.min.css
  Cache-Control: public, no-cache

/*.js
  Cache-Control: public, no-cache

# Images — long-lived (webp, svg, png, jpg)
/Assets/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/*.webp
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/*.svg
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

# Fonts — immutable once deployed
/*.woff2
  Cache-Control: public, max-age=31536000, immutable

/*.woff
  Cache-Control: public, max-age=31536000, immutable
