{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "codegraph": {
      "type": "local",
      "command": [
        "codegraph",
        "serve",
        "--mcp"
      ],
      "enabled": true
    }
  },
  "agent": {
    "plan":  { "model": "opencode-go/glm-5.2" },
    "build": { "model": "opencode-go/kimi-2.7-code" }
  }
}
